{
  "name": "textworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "prestart": "npm run build",
    "start": "node server/index.js",
    "deploy:production": "node scripts/deploy-production.mjs",
    "cdn:enable": "node scripts/cdn-policy.mjs --enable",
    "cdn:verify": "node tests/cdn-public.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "experiment": "node experiments/topology.mjs",
    "playtest": "node experiments/playtest/run.mjs",
    "playtest:live": "node experiments/playtest/control.mjs",
    "experiment:density": "node experiments/density.mjs && node experiments/local-continuity.mjs",
    "test:input": "node tests/input-regression.mjs",
    "test:writing": "node tests/writing-interactions.mjs",
    "test:ime": "node tests/standard-input.mjs",
    "test:motion": "node tests/motion-browser.mjs",
    "test:cjk": "node tests/cjk-browser.mjs",
    "test:typing": "node tests/typing-latency.mjs",
    "test:viewport": "node tests/viewport-motion.mjs",
    "test:freshness": "node tests/freshness-browser.mjs",
    "bench:scale": "node scripts/scale-bench.mjs",
    "metrics:report": "node scripts/metrics-report.mjs",
    "metrics:usage": "node scripts/usage-report.mjs",
    "test:measurements": "node tests/measurements-browser.mjs",
    "metrics:export": "node scripts/export-metrics.mjs",
    "test:topology": "node tests/topology-browser.mjs && node tests/topology-cursor.mjs && node tests/topology-continuity.mjs",
    "test:fonts": "node tests/font-loading.mjs",
    "test:browsers": "node tests/cross-browser.mjs",
    "bench:first-visit": "node experiments/first-visit.mjs",
    "test:cost-browser": "node tests/cost-browser.mjs",
    "test:public": "node tests/public-smoke.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "ws": "^8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "esbuild": "0.28.2",
    "playwright": "^1.56.1"
  }
}
